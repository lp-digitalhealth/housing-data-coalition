###  urn:leavitt-partners:medicaid-payment-model#hasStatus
med-pay:hasStatus rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:domain med-pay:Authorization ;
                  rdfs:range med-pay:Status ;
                  rdfs:label "hasStatus" .


###  urn:leavitt-partners:medicaid-payment-model#hasTribalAffiliation
med-pay:hasTribalAffiliation rdf:type owl:ObjectProperty ;
