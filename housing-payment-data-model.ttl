                               rdfs:label "hasMedicaidInformation"@en .


###  urn:leavitt-partners:medicaid-payment-model#hasModalityofService
med-pay:hasModalityofService rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf owl:topObjectProperty ;
                             rdfs:domain med-pay:Service_Encounters ;
                             rdfs:range med-pay:Modality_of_Service ;
                             rdfs:label "hasModalityofService"@en .


###  urn:leavitt-partners:medicaid-payment-model#hasPlaceofService
med-pay:hasPlaceofService rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf owl:topObjectProperty ;
