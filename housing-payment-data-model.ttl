@prefix : <urn:housing-payment-data-model> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix med-pay: <urn:leavitt-partners:medicaid-payment-model#> .
@base <urn:housing-payment-data-model> .

<urn:absolute:housing-payment-data-model> rdf:type owl:Ontology ;
                                           owl:versionIRI <urn:absolute:housing-payment-data-model> .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#notation
<http://www.w3.org/2004/02/skos/core#notation> rdf:type owl:AnnotationProperty ;
                                               rdfs:label "skos:notation" .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  urn:leavitt-partners:medicaid-payment-model#hasAuthorization
med-pay:hasAuthorization rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf owl:topObjectProperty ;
                         rdfs:domain med-pay:Person ;
                         rdfs:range med-pay:Authorization ;
                         rdfs:label "hasAuthorization" .


###  urn:leavitt-partners:medicaid-payment-model#hasAuthorizedService
med-pay:hasAuthorizedService rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf owl:topObjectProperty ;
                             rdfs:domain med-pay:Person ;
                             rdfs:range med-pay:Authorized_Service ;
                             rdfs:label "hasAuthorizedService" .


###  urn:leavitt-partners:medicaid-payment-model#hasCarePlan
med-pay:hasCarePlan rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdfs:domain med-pay:Person ;
                    rdfs:range med-pay:Care_Plan ;
                    rdfs:label "hasCarePlan" .


###  urn:leavitt-partners:medicaid-payment-model#hasGoalStatus
med-pay:hasGoalStatus rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      rdfs:domain med-pay:Goals ;
                      rdfs:range med-pay:Goal_Status ;
                      rdfs:label "hasGoalStatus"@en .


###  urn:leavitt-partners:medicaid-payment-model#hasGoals
med-pay:hasGoals rdf:type owl:ObjectProperty ;
                 rdfs:domain med-pay:Care_Plan ;
                 rdfs:range med-pay:Goals ;
                 rdfs:label "hasGoals" .


