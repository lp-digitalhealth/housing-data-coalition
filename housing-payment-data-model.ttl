#################################################################
#    Classes
#################################################################

###  urn:leavitt-partners:medicaid-payment-model#Authorization
med-pay:Authorization rdf:type owl:Class ;
                      rdfs:label "Authorization" .


###  urn:leavitt-partners:medicaid-payment-model#Authorized_Service
med-pay:Authorized_Service rdf:type owl:Class ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty med-pay:hasUnitType ;
                                             owl:someValuesFrom med-pay:Unit_Type
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty med-pay:Unit_Value ;
                                             owl:allValuesFrom xsd:integer
                                           ] ;
                           rdfs:label "Authorized Service" .


###  urn:leavitt-partners:medicaid-payment-model#Care_Plan
med-pay:Care_Plan rdf:type owl:Class ;
                  rdfs:label "Care Plan" .


###  urn:leavitt-partners:medicaid-payment-model#Goal_Status
med-pay:Goal_Status rdf:type owl:Class ;
                    rdfs:label "Goal Status"@en .


###  urn:leavitt-partners:medicaid-payment-model#Goals
med-pay:Goals rdf:type owl:Class ;
              rdfs:label "Goals" .


###  urn:leavitt-partners:medicaid-payment-model#MedicaidInformation
med-pay:MedicaidInformation rdf:type owl:Class ;
                            rdfs:label "Medicaid Information"@en .


###  urn:leavitt-partners:medicaid-payment-model#Modality_of_Service
med-pay:Modality_of_Service rdf:type owl:Class ;
                            rdfs:label "Modality of Service"@en .


###  urn:leavitt-partners:medicaid-payment-model#Person
med-pay:Person rdf:type owl:Class ;
               rdfs:label "Person"@en .


###  urn:leavitt-partners:medicaid-payment-model#Place_of_Service
med-pay:Place_of_Service rdf:type owl:Class ;
                         rdfs:label "Place of Service"@en .


###  urn:leavitt-partners:medicaid-payment-model#Service_Encounters
med-pay:Service_Encounters rdf:type owl:Class ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
