                                             owl:someValuesFrom med-pay:Unit_Type
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty med-pay:Unit_Value ;
                                             owl:allValuesFrom xsd:integer
                                           ] ;
                           rdfs:label "Service Encounters" .


###  urn:leavitt-partners:medicaid-payment-model#Sex
med-pay:Sex rdf:type owl:Class ;
            rdfs:label "Sex"@en .


###  urn:leavitt-partners:medicaid-payment-model#Status
med-pay:Status rdf:type owl:Class ;
               rdfs:label "Status"@en .


###  urn:leavitt-partners:medicaid-payment-model#TribalAffiliation
